# ---------------------------------------------------------------------------
# ByteMe backend — environment template
# Copy to `.env.local` (Next.js) or `.env` and fill in real values.
#
# SECURITY RULE
# ------------
# Every variable below is read on the SERVER ONLY.
# `lib/env.ts` deliberately refuses to read any value that is also exposed
# through a `NEXT_PUBLIC_` variable, and it never prefixes a secret with
# `NEXT_PUBLIC_`. Supabase secrets must NOT be prefixed with `NEXT_PUBLIC_`:
#   - NEXT_PUBLIC_SUPABASE_URL        (publishable project URL, safe)
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY   (publishable anon key, safe)
#   - SUPABASE_SERVICE_ROLE_KEY       (SECRET — never public, never NEXT_PUBLIC_)
#
# If the browser ever needs to talk to Supabase directly, expose only the
# project URL and the anon key, and rely on Row Level Security. ByteMe's own
# API server uses the service-role key and is never called from the browser
# with that credential.
#
# With BYTEME_OFFLINE_MODE=true neither Supabase variable is read at all, so a
# machine running fully offline needs no credential in this file whatsoever.
# ---------------------------------------------------------------------------

# --- Supabase (required unless BYTEME_OFFLINE_MODE=true) -------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Secret. Server-only. Rotating this invalidates all API access.
SUPABASE_SERVICE_ROLE_KEY=

# --- Offline SQLite backend -------------------------------------------------
# false (default) -> Supabase. This is the primary, online path, unchanged.
# true            -> a local SQLite file. No network and no credentials, with
#                    the same repositories, services, schemas and responses.
# Run `npm run offline:seed` once to create the schema and load generic demo
# data before starting the server.
BYTEME_OFFLINE_MODE=false
# Where the SQLite file lives. Empty means ./byteme-offline.db.
# Set to ':memory:' for a throwaway database that never touches disk.
# No credential is ever written into this file.
BYTEME_OFFLINE_DB_PATH=

# Signs the development access tokens used while offline. Use at least 32 bytes.
# Server-only secret:
# never NEXT_PUBLIC_, never returned to a client, never written to the database.
# Leave blank online. Set it offline, or every protected route answers 500
# configuration_error. Mint a token with:
#   npm run offline:token -- --factory <uuid>
#   npm run offline:token -- --admin
BYTEME_OFFLINE_JWT_SECRET=

# --- Authentication (see README "Authentication") -------------------------
# Callers authenticate with Supabase Auth and send the access token as
# `Authorization: Bearer <token>`. ByteMe has no login endpoint of its own.
#
# Factory access is granted through the token's SERVER-CONTROLLED app_metadata:
#   app_metadata.factory_ids  ["<uuid>", ...]  factories this user owns
#   app_metadata.byteme_admin true               every factory (operators)
# `user_metadata` is ignored on purpose: the end user can write it, so a grant
# read from there could be set by the user themselves.
#
# Grants are set from the Supabase dashboard (Authentication > Users, then
# "Edit App Metadata") or by a service-role script. No migration is needed.
#
# Every endpoint under /api/v1/factories requires a valid token. The only public
# endpoint is GET /api/v1/health, so a monitoring probe needs no credentials.

# --- Application (optional) -------------------------------------------------
# Free-form identifier reported by /api/v1/health
APP_NAME=ByteMe
APP_VERSION=0.1.0
NODE_ENV=development
# Set true only when production traffic is served exclusively over HTTPS.
BYTEME_HSTS_ENABLED=false

# --- Optimizer (optional; demo-only local Python integration) --------------
# Local Python mode starts the existing optimizer.public_api in a bounded
# child process. This is for the synthetic mock/demo integration only.
BYTEME_OPTIMIZER_ENABLED=false
# Set to python-subprocess to invoke ../optimizer locally. The default `http`
# keeps the existing explicitly configured HTTP transport available.
BYTEME_OPTIMIZER_TRANSPORT=python-subprocess
# On Windows, set this to the Python executable that has OR-Tools installed,
# for example C:\Python313\python.exe. Do not use a browser/public variable.
BYTEME_OPTIMIZER_PYTHON_EXECUTABLE=
# Defaults to the repository root (parent of backend), so `optimizer` imports
# as a package. Set explicitly only if the server starts from another folder.
BYTEME_OPTIMIZER_PYTHON_WORKING_DIRECTORY=
# HTTP transport settings (used only when BYTEME_OPTIMIZER_TRANSPORT=http).
BYTEME_OPTIMIZER_BASE_URL=
BYTEME_OPTIMIZER_SOLVE_PATH=
BYTEME_OPTIMIZER_SOLVE_METHOD=
BYTEME_OPTIMIZER_DECODER=
BYTEME_OPTIMIZER_API_KEY=
# Total solve timeout in milliseconds (default 60000, max 300000).
BYTEME_OPTIMIZER_TIMEOUT_MS=60000
